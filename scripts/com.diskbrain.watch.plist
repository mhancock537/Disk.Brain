<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.diskbrain.watch</string>

  <!-- Cheap work only: stat, hash, extract, mark deleted. Enrichment and
       embedding are queued for the drain agent, so this never touches the GPU
       and never competes with anything you are doing. -->
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/kb</string>
    <string>watch</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/watch.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/watch.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
